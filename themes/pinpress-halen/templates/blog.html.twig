{# Overview page: lists its child pages (content.items in the page header). #}
{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/blog_sidebar_header.html.twig' %}
{{ page.content|raw }}
{% for child in page.collection() %}
  {% include 'partials/entry.html.twig' with {'page': child} %}
{% endfor %}
{% include 'partials/blog_sidebar_footer.html.twig' %}
{% endblock %}
