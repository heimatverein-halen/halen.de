{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/blog_sidebar_header.html.twig' %}
<div class="post">
  <div class="entry-container">
    <div class="entry-content  single">
      <h1 class="entry-title single">{{ page.header.title }}</h1>

      {% set image = page.media.images|first %}
      {% if image %}
        <div class="bildklein">
          {{ image.lightbox().cropResize(200,180).html('', image.meta.alt_text ?: page.title, '')|raw }}<br />
          {{ image.meta.alt_text }}
        </div>
      {% endif %}

      {{ page.content|raw }}
      <div class="clear"></div>
    </div>
  </div>
</div>
{% include 'partials/blog_sidebar_footer.html.twig' %}
{% endblock %}
