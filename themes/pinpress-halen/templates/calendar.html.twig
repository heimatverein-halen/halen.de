{# Dorfkalender: upcoming events from the .ics file(s) uploaded to this page. #}
{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/blog_sidebar_header.html.twig' %}
<div class="post">
  <div class="entry-container">
    <div class="entry-content">
      <h1 class="entry-title">{{ page.title }}</h1>

      {% set events = calendar_events(page) %}
      {% if events is empty %}
        <p>Zurzeit sind keine Termine eingetragen.</p>
      {% else %}
        <div class="termine">
        {% for event in events %}
          {% if loop.first or event.day != events[loop.index0 - 1].day %}
            <h2 class="termine-tag">{{ event.day }}</h2>
          {% endif %}
          <div class="termin">
            <span class="termin-zeit">{{ event.time ?? 'Ganztägig' }}</span>
            <span class="termin-titel">{{ event.title }}{% if event.location %} <small>({{ event.location }})</small>{% endif %}</span>
          </div>
        {% endfor %}
        </div>
      {% endif %}

      {{ page.content|raw }}

      {% for file in page.media.files|filter(f => f.extension == 'ics') %}
        {% set url = page.url(true) ~ '/' ~ file.filename %}
        <p><i class="fa fa-calendar"></i> Termine im eigenen Kalender:
          <a href="{{ url|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}">abonnieren</a>
          oder <a href="{{ url }}" download>herunterladen</a></p>
      {% endfor %}
    </div>
  </div>
</div>
{% include 'partials/blog_sidebar_footer.html.twig' %}
{% endblock %}
