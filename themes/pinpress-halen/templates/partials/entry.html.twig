{# One page or post: title, date and tags (posts only), photos, text. #}
{# Images already embedded in the text are not repeated. #}
{% set images = page.media.images|filter(image => image.filename not in page.content) %}
<div class="post">
  <div class="entry-container">
    <div class="entry-content">
      <h1 class="entry-title">{{ page.title }}</h1>

      {% if page.header.date or page.taxonomy.tag %}
      <div class="meta1">
        <p><small>
          {% if page.header.date %}
          <span><i class="fa fa-clock-o"></i> {{ page.date|date(config.system.pages.dateformat.long) }}</span>
          {% endif %}
          {% if page.taxonomy.tag %}
          <span><i class="fa fa-tags"></i>
            {% for tag in page.taxonomy.tag %}
            <a href="{{ base_url_relative }}{{ site.blog.route }}/tag{{ config.system.param_sep }}{{ tag|e('url') }}" rel="tag">{{ tag }}</a>{% if not loop.last %}, {% endif %}
            {% endfor %}
          </span>
          {% endif %}
        </small></p>
      </div>
      {% endif %}
      <div class="clear"></div>

      {% if images|length == 1 %}
        {% set image = images|first %}
        <div class="entry-image">
          {{ image.lightbox().cropResize(750, 422).html('', image.meta.alt_text ?: page.title, 'thumb')|raw }}
          {{ image.meta.alt_text }}
        </div>
      {% endif %}

      {{ page.content|raw }}

      {% if images|length > 1 %}
        <div class="gallery">
          {% include 'partials/gallery.html.twig' %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
