{% do assets.addCss('theme://css/item.css') %}
<div class="post">
  <div class="entry-container">
    <div class="entry-content">
      <h1 class="entry-title">{{ page.title }}</h1>

      {{ page.content|raw }}

      {% if page.media.images|first %}
        {% for image in page.media.images %}
    	    <div class="image" style="float: left; width : 200px; padding: 10px; text-align: center">
            {% if image.meta.alt_text %}
    		      {{ image.lightbox().cropZoom(200,180).html('', image.meta.alt_text, '')|raw }}<br />
    	        {{ image.meta.alt_text }}
            {% else %}
              {{ image.lightbox().cropZoom(200,180).html('', page.title, '')|raw }}<br />
            {% endif %}
    		  </div>
        {% endfor %}
    	  <div class="clear"></div>
      {% endif %}

    </div>
  </div>
</div>
