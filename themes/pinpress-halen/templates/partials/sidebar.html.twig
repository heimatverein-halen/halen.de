{% set modules = page.collection({'items': {'@taxonomy.category': 'sidebar'}, 'order': {'by': 'default', 'dir': 'asc'}}) %}
{% for module in modules %}
  {% if module.template and module.header.surround %}
    {% include 'sidebar/' ~ module.template ~ '.html.twig' %}
  {% endif %}
{% endfor %}

<div class="sidebar section" id="sidebar">
{% for module in modules %}
  {% if module.template and not module.header.surround %}
    {% include 'sidebar/' ~ module.template ~ '.html.twig' %}
  {% endif %}
{% endfor %}

{% if config.plugins.simplesearch.enabled %}
<div class="widget HTML">
  <h2 class="title">Suche</h2>
  <div class="widget-content simplesearch">
    {% include 'partials/simplesearch_searchbox.html.twig' %}
  </div>
</div>
{% endif %}

{% if config.plugins.archives.enabled %}
<div class="widget HTML">
  <h2 class="title">Archiv der Veranstaltungen</h2>
  <div class="widget-content">
    {% include 'partials/archives-year.html.twig' %}
  </div>
</div>
{% endif %}

{% if config.plugins.feed.enabled %}
{% set feed_url = base_url_relative ~ site.blog.route %}
<div class="widget HTML syndicate">
  <h2 class="title">Feed</h2>
  <div class="widget-content">
    <a class="button" href="{{ feed_url }}.atom"><i class="fa fa-rss-square"></i> Atom</a>
    <a class="button" href="{{ feed_url }}.rss"><i class="fa fa-rss-square"></i> RSS</a>
  </div>
</div>
{% endif %}
</div>
