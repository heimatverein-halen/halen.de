{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/blog_sidebar_header.html.twig' %}
<div class="post">
  <div class="entry-container">
    <div class="entry-content  single">
      <h1 class="entry-title single">{{ page.header.title }}</h1>
      {{ page.content|raw }}
      {% if page.media.images|first %}
         {% for image in page.media.images %}
    	    <div class="image" style="float: left; width : 200px; padding: 10px; text-align: center">
            {% if image.meta.alt_text %}
              {{ image.lightbox().cropZoom(200,180).html('', image.meta.alt_text, '')|raw }}<br />
              {{ image.meta.alt_text }}
            {% else %}
              {{ image.lightbox().cropZoom(200,180).html('', page.title, '')|raw }}<br />
            {% endif %}
    	  	</div>
    	  {% endfor %}
		    <div class="clear"></div>
      {% endif %}
    </div>
  </div>
</div>
{% include 'partials/blog_sidebar_footer.html.twig' %}
{% endblock %}
