{# Overview page as one photo grid: every child's photos, captioned with the child's title. #}
{% extends 'partials/base.html.twig' %}

{% block content %}
{% include 'partials/blog_sidebar_header.html.twig' %}
<div class="post">
  <div class="entry-container">
    <div class="entry-content">
      <h1 class="entry-title">{{ page.title }}</h1>
      {{ page.content|raw }}
      <div class="gallery">
        {% for child in page.collection() %}
          {% include 'partials/gallery.html.twig' with {'images': child.media.images, 'caption': child.title} %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% include 'partials/blog_sidebar_footer.html.twig' %}
{% endblock %}
