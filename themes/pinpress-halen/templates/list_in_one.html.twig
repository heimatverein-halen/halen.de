{% embed 'partials/base.html.twig' %}

    {% set collection = page.collection() %}
    {% set base_url = page.url %}
    {% set feed_url = base_url %}

    {% if base_url == '/' %}
    {% set base_url = '' %}
    {% endif %}

    {% if base_url == base_url_relative %}
    {% set feed_url = base_url~'/'~page.slug %}
    {% endif  %}

    {% block content %}
    {% do assets.addCss('theme://css/item.css') %}

      {{ page.content|raw }}
      {% include 'partials/blog_sidebar_header.html.twig' %}

      <div class="post">
        <div class="entry-container">
          <div class="entry-content">
            <h1 class="entry-title">{{ page.title }}</h1>
            {% for page in collection %}
              {% if page.media.images|first %}
                {% for image in page.media.images %}
                  <div class="image" style="float: left; width : 200px; padding: 10px; text-align: center">
                      {{ image.lightbox().cropZoom(200,180).html('', page.title, '')|raw }}<br />
                      {{ page.title }}
                  </div>
                {% endfor %}
              {% endif %}
            {% endfor %}
            <div class="clear"></div>
            </div>
          </div>
        </div>

        {% if config.plugins.pagination.enabled and collection.params.pagination %}
        {% include 'pagination.html.twig' with {'pagination':collection.params.pagination} %}
        {% endif %}

        {% include 'partials/blog_sidebar_footer.html.twig' %}
    {% endblock %}

{% endembed %}
