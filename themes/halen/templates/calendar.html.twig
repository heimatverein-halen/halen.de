{# Dorfkalender: upcoming events from the .ics file(s) uploaded to this page (calendar_events() in halen.php). #}
{% extends 'partials/base.html.twig' %}
{% set blog = page.find(theme_var('blog-page')) %}

{% block content %}
  {% embed 'partials/layout.html.twig' %}
    {% block item %}
      <article class="content-item">
        <header class="content-title"><h1>{{ page.title }}</h1></header>

        {% set events = calendar_events(page) %}
        {% if events is empty %}
          <p>Zurzeit sind keine Termine eingetragen.</p>
        {% else %}
          <div class="termine">
          {% for event in events %}
            {% if loop.first or event.day != events[loop.index0 - 1].day %}
              <h2 class="termine-tag">{{ event.day }}</h2>
            {% endif %}
            <div class="termin">
              <span class="termin-zeit">{{ event.time ?? 'Ganztägig' }}</span>
              <span class="termin-titel">{{ event.title }}{% if event.location %} <small>({{ event.location }})</small>{% endif %}</span>
            </div>
          {% endfor %}
          </div>
        {% endif %}

        {{ page.content|raw }}

        {% for file in page.media.files|filter(f => f.extension == 'ics') %}
          {% set url = page.url(true) ~ '/' ~ file.filename %}
          <p class="termine-abo">
            <a role="button" href="{{ url|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}"><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> Im eigenen Kalender abonnieren</a>
            <a role="button" class="secondary outline" href="{{ url }}" download><i class="fa-solid fa-download" aria-hidden="true"></i> Herunterladen</a>
          </p>
        {% endfor %}
      </article>
    {% endblock %}
    {% block sidebar %}{% include 'partials/sidebar.html.twig' %}{% endblock %}
  {% endembed %}
{% endblock %}
