{# PhotoSwipe (js/photoswipe*.esm.min.js, css/photoswipe.css, MIT, v5.4.4) for every photo link with data-pswp-width, caption from data-title #}
{% do assets.addCss('theme://css/photoswipe.css') %}
<script type="module">
  import PhotoSwipeLightbox from '{{ url('theme://js/photoswipe-lightbox.esm.min.js') }}';
  const lightbox = new PhotoSwipeLightbox({bgOpacity: 0.93, gallery: '.content-item', children: 'a[data-pswp-width]', pswpModule: () => import('{{ url('theme://js/photoswipe.esm.min.js') }}')});
  lightbox.on('uiRegister', () => lightbox.pswp.ui.registerElement({name: 'caption', appendTo: 'root', onInit: (el, pswp) => pswp.on('change', () => { el.textContent = pswp.currSlide.data.element?.dataset.title || ''; })}));
  lightbox.init();
</script>
